# Monad 测试网配置
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_TESTNET_EXPLORER=https://testnet.monadscan.com

# 钱包配置
# 推荐使用加密私钥（运行 `npx tsx src/cli-encrypt.ts` 生成）
