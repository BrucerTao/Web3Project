{
  "name": "0g-agentic-trading-arena",
  "version": "1.0.0",
  "description": "AI-driven perpetual strategy agent built on 0G modular infrastructure",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "api": "tsx watch src/api-server.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint src/",
    "compile": "npx hardhat compile",
    "deploy:local": "npx hardhat run scripts/deploy-local.cjs --network hardhat",
    "deploy:ganache": "npx hardhat run scripts/deploy-local.cjs --network ganache",
    "deploy:testnet": "npx hardhat run scripts/deploy-local.cjs --network zerog_testnet",
    "test:local": "node scripts/test-local.cjs",
    "test:contract": "npx hardhat test test/TradingAgent.test.cjs --network hardhat",
    "test:integration": "npx hardhat run scripts/integration-test.cjs --network hardhat"
  },
  "dependencies": {
    "@0glabs/0g-ts-sdk": "^0.2.0",
    "axios": "^1.7.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "ethers": "6.13.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.5.5",
    "eslint": "^9.11.1",
    "hardhat": "^2.22.10",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typechain": "^8.3.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "keywords": [
    "0g",
    "web3",
    "ai-trading",
    "defi",
    "tee"
  ],
  "author": "",
  "license": "MIT"
}
