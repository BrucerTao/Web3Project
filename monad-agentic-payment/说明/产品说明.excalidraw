    {
      "id": "Cm-IX-SxAZHssjIlnEyD4",
      "type": "text",
      "x": 1212.6493727331406,
      "y": 345.5327516121843,
      "width": 1032.6199951171875,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
